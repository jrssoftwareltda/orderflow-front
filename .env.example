# Leave blank to use same-origin /api routes through Vite/Nginx proxy.
VITE_API_BASE_URL=

# Development-only Vite proxy target.
VITE_DEV_API_PROXY=http://localhost:8080

# trace | debug | info | warn | error | silent
VITE_LOG_LEVEL=info

# Logs request/response bodies and extra backend-call diagnostics when true.
VITE_DEBUG_API=false

# Shows the in-app diagnostics drawer when true.
VITE_DEBUG_UI=false
